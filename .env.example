APP_ENV=development
ACCOUNT_AUTH_MODE=false
APP_PUBLIC_URL=http://localhost:3000
REQUIRE_EMAIL_VERIFICATION=false
EMAIL_DELIVERY_BACKEND=disabled
# SMTP settings are required before enabling email verification.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_FROM_EMAIL=security@example.com
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false
PUBLIC_DEMO_MODE=false
# Required when ACCOUNT_AUTH_MODE=true or outside local development. Keep this stable;
# losing it makes encrypted database fields and uploaded files unreadable.
# ENCRYPTION_MASTER_KEY=
# Required only when PUBLIC_DEMO_MODE=true. Use a long random secret in hosted environments.
# SESSION_SECRET=
# Omit DATABASE_URL to use persistent local SQLite at data/local/enterprise_ai.db.
# DATABASE_URL=postgresql+psycopg://app_runtime:local-development-only@localhost:5432/enterprise_ai
MIGRATION_DATABASE_URL=postgresql+psycopg://app_owner:local-development-only@localhost:5432/enterprise_ai
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOCAL_STORAGE_PATH=data/local/uploads
# Use `local` for development or `s3` for persistent production storage.
OBJECT_STORAGE_BACKEND=local
# Set to the exported Next.js directory only when the API also serves the production web build.
# WEB_STATIC_DIR=apps/web/out
# S3-compatible settings. Keep the bucket private; endpoint is omitted for AWS S3.
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=enterprise-ai-local
OBJECT_STORAGE_SECRET_KEY=local-development-only
OBJECT_STORAGE_BUCKET=enterprise-ai-documents
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_PREFIX=development
OBJECT_STORAGE_FORCE_PATH_STYLE=true
# Optional; AWS S3 supports AES256. R2 encrypts objects at rest automatically.
# OBJECT_STORAGE_SSE=AES256

# AI is private/local by default. Enabling an external provider sends authorized
# document chunks for embeddings and question evidence for answer generation.
AI_PROVIDER=local
EMBEDDING_PROVIDER=disabled
AI_ALLOW_RESTRICTED=false
# Local AI option (both run on the API machine; no API key):
# AI_PROVIDER=ollama
# EMBEDDING_PROVIDER=ollama
# AI_MODEL=qwen3:4b
# EMBEDDING_MODEL=bge-m3
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_TIMEOUT_SECONDS=180
# Start the Ollama server with OLLAMA_NO_CLOUD=1; never expose its port publicly.
# Required only when the corresponding provider is `openai`.
# OPENAI_API_KEY=
# OPENAI_PROJECT=
OPENAI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=
# EMBEDDING_MODEL=
# EMBEDDING_DIMENSIONS=
AI_REQUEST_TIMEOUT_SECONDS=30

# Encrypted PostgreSQL backups use a separate key and preferably a separate private bucket.
# Generate the key with: openssl rand -base64 32
# BACKUP_ENCRYPTION_KEY=
BACKUP_STORAGE_BACKEND=local
BACKUP_STORAGE_PATH=data/local/backups
BACKUP_RETENTION_DAYS=35
BACKUP_MIN_RECOVERY_POINTS=7
AUDIT_RETENTION_DAYS=2555
# BACKUP_STORAGE_ENDPOINT=
# BACKUP_STORAGE_ACCESS_KEY=
# BACKUP_STORAGE_SECRET_KEY=
# BACKUP_STORAGE_BUCKET=
# BACKUP_STORAGE_REGION=us-east-1
# BACKUP_STORAGE_PREFIX=database-backups
# BACKUP_STORAGE_FORCE_PATH_STYLE=false
# BACKUP_STORAGE_SSE=AES256

